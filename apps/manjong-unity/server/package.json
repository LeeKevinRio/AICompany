{
  "name": "manjong-unity-server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative game server for manjong-unity (Taiwanese 16-tile mahjong).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
