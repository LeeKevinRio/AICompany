# stock-desk 環境變數範本 — 只放假值,真值放同目錄的 .env(已被 .gitignore)。
# Phase 1 尚無外部資料源;之後接資料源 / 警示 webhook 時在此擴充。

# 前端(瀏覽器端)呼叫後端 API 的位址
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# FinMind 備援資料源(選填)
FINMIND_API_TOKEN=

# 警示推播(Phase 6,選填;無值就只記本機事件不推播)
ALERT_DISCORD_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# 排程間隔(分鐘)
SCHEDULER_DATA_INTERVAL_MINUTES=1440
SCHEDULER_ALERT_INTERVAL_MINUTES=60

# SQLite 資料庫路徑(選填;compose.yaml 已為 backend / scheduler 兩個 service
# 明確設成 /app/data/stock-desk.db,並掛載到同一個具名 volume。若在容器外
# 直接跑,兩個 process 務必指向同一個檔案,否則排程寫入的資料 API 讀不到。
STOCK_DESK_DB_PATH=

# 美股資料源 Alpha Vantage(Phase 7;未設 API key 時 adapter 直接回 unavailable,fail-closed)
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_DAILY_LIMIT=25
ALPHA_VANTAGE_SAFETY_MARGIN=2
ALPHA_VANTAGE_MIN_INTERVAL_SECONDS=12.0
QUOTA_RESET_TZ=UTC
